{
  "name": "@wolfchatter/api",
  "version": "0.0.0",
  "private": true,
  "description": "Wolfchatter REST and Socket.IO API",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.example --env-file-if-exists=.env src/db/migrate.ts",
    "dev": "node --watch --env-file=.env.example --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@wolfchatter/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "socket.io-client": "4.8.3"
  }
}
