# Working defaults for local development, loaded by `pnpm dev`, `pnpm db:migrate` and the tests.
# Override any value in apps/api/.env (gitignored). Deployed environments set real variables.
DATABASE_URL=postgres://wolfchatter:wolfchatter@localhost:5433/wolfchatter
# Only this machine can reach the dev server. Deployed servers default to 0.0.0.0.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
