# Working defaults for local development, loaded by `pnpm dev`, `pnpm db:migrate` and the tests.
# Override any value in apps/api/.env (gitignored). Deployed environments set real variables.
# 127.0.0.1, not localhost: on macOS, resolving localhost sometimes takes 5 seconds (CLAUDE.md).
DATABASE_URL=postgres://wolfchatter:wolfchatter@127.0.0.1:5433/wolfchatter
# Only this machine can reach the dev server. Deployed servers default to 0.0.0.0.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API and open sockets (Vite's dev server).
CORS_ORIGINS=http://localhost:5173
# Proxies trusted to report client addresses in X-Forwarded-For: IPs, CIDR ranges, loopback,
# linklocal or uniquelocal. Empty trusts none, which is right when nothing sits in front.
TRUST_PROXY=
