{
  "name": "wolfchatter",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time chat on a map",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm worklog:check",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @wolfchatter/api db:generate",
    "db:migrate": "pnpm --filter @wolfchatter/api db:migrate",
    "db:up": "docker compose up --detach --wait",
    "dev": "pnpm db:up && pnpm db:migrate && pnpm --parallel --filter @wolfchatter/api --filter @wolfchatter/web dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @wolfchatter/web test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "worklog:check": "node packages/worklog/src/cli/check.ts",
    "worklog:new": "node packages/worklog/src/cli/new.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "@wolfchatter/worklog": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
